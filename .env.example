PORT=3001
CORS_ORIGIN=http://localhost:5173
SUPABASE_URL=https://bokjsjmwvyoxbduxyoth.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Opcional; no se necesita para verificar JWT mediante JWKS.
SUPABASE_SECRET_KEY=
# Para producción: AUTH_DRIVER=supabase y conexiones separadas.
